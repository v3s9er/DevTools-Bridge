{
  "manifest_version": 3,
  "name": "DevTools Bridge",
  "version": "0.2.1",
  "minimum_chrome_version": "116",
  "description": "Open a local DevTools frontend for the current tab through chrome.debugger.",
  "author": "v3s9er",
  "permissions": ["activeTab", "debugger"],
  "host_permissions": ["http://127.0.0.1:18765/*"],
  "action": {
    "default_title": "Open DevTools Bridge",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
